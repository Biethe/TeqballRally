node_modules/
dist/
.firebase/
.vite/

# Local configuration and logs
.env
.env.*
!.env.example
*.log

# Browser test output. The helper scripts write to /tmp; these catch stray
# local runs that drop captures into the working tree.
playwright-report/
test-results/
*.png
*.webm
# ...but the Android launcher icons are source assets, not test output. Without
# this the native build fails on a missing @mipmap/ic_launcher resource.
!android/app/src/main/res/**/*.png

# The accounts store, when the relay is run locally. Player records are not
# something to commit, and DATA_DIR moves them somewhere real in production.
data/
server/data/

# Windows download metadata accidentally copied with assets
*:Zone.Identifier

# Android signing. The upload key and its password are the identity Google Play
# checks every release against: committing them hands anyone with repository
# access the ability to publish as this app. Keep them off the machine too —
# losing them means Play will not accept an update until Google resets the key.
android/keystore.properties
# ...and wherever else they land. The properties file was sitting untracked and
# un-ignored at the repo root, which the rule above does not match, and a
# certificate is not a .jks so nothing caught that either.
keystore.properties
*.jks
*.keystore
*.pem

# Raw Blender exports. Packing (scripts/pack-model.sh) is lossy and one-way,
# so the unpacked originals are kept out of the repo rather than committed
# alongside the packed ones.
raw/

# The art. None of it is committed, and this is the load-bearing part of
# protecting it — not the AES in scripts/scramble.mjs.
#
# The models, textures, venue cards, audio and video are licensed packs whose
# terms forbid redistributing them in a form other tools can open. A public
# repository is exactly that, and it does not matter how good the cipher in the
# build step is if the plaintext is one `git clone` away beside it. Everything
# here comes from the bundle instead: `npm run assets:fetch`, or
# scripts/pack-assets.mjs to make a new one.
#
# The fonts and the meshopt decoder are the exceptions and stay committed: Exo
# 2 is under the Open Font Licence and the decoder is a public third-party
# script, so neither is anybody's to withhold, and both are needed for the page
# to render at all.
assets/*
!assets/fonts/
!assets/meshopt_decoder.js
!assets/manifest.json
# ...and the brand mark, which is this app's own icon and not licensed art —
# the same image is already committed as the Android launcher icon. It lives
# here because `publicDir` is `assets/`, so anything the page asks for by URL
# has to be under it. Committed rather than left to the art bundle because the
# bundle is a snapshot: this file was added to `assets/` after the last pack,
# so every build made anywhere but the machine it was drawn on fetched a
# bundle without it and rendered a broken image in every screen header.
!assets/figma/
!assets/figma/icon.png
art-source/
art-bundle.teq
*.glb
*.gltf
*.fbx
*.blend
*.blend1

# Design-tool exports and scratch. `revamp_ui/` and `figma_export/` are two
# Figma Make React apps kept beside the game as UI reference; nothing in the
# build reads them, and their lockfiles and node_modules made the repository
# look like it shipped three applications. Same for the zips they arrived in.
# They stay on disk, out of git.
revamp_ui/
figma_export/
*.zip

# Harness scratch from getting Chromium to run headless on a machine without
# ALSA — a compiled .so and the probes that produced it. Machine-local by
# definition: a binary blob in a repository is nobody's idea of a source file.
.verify-logs/

# Editor/agent local settings.
.qoder/

# Agent/editor scratch that is not the game.
.claude/

# Vite's unused publicDir alternative. `publicDir` is `assets/`; files here
# never reach a build, and an empty folder at the root is just noise.
public/

# Leftover empty directory from an older accounts store path.
store/

# Machine-local dumps (raw mocap, Figma zips, one-off bundles) that used to
# sit at the repository root. The game does not read them.
scratch/

# Working papers. DESIGN.md, TUNING, purchases notes, legal drafts — they stay
# on this machine. The clip sheet the tests parse is `tests/Animation.txt`.
docs/

# The legal pages. Same reason as the brand icon above: `publicDir` is
# `assets/`, so anything the page must serve by URL lives here — and the art
# bundle is a snapshot, so a file added after the last pack is missing from
# every build but this machine's unless it is committed. These were sitting in
# `public/`, which reaches neither the build nor Firebase hosting (it serves
# `dist/`), so the "Open in Web Browser" link on the legal screen was a 404 in
# every shipped build and Play had no privacy URL to check.
!assets/privacy.html
!assets/terms.html
!assets/data-deletion.html
