<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
    </style>


    <!--
      The launch screen, on both of the two paths Android takes to it.

      `android:background` is the pre-Android-12 route and points at the
      generated drawable/splash.png (see scripts/make-splash.mjs). Android 12
      and up ignores it and draws its own splash from the windowSplashScreen*
      attributes instead, which is why both are set: with only the first, a
      modern phone fell back to the framework default and showed Capacitor's
      logo on white before a dark game.

      No postSplashScreenTheme is needed — Capacitor's BridgeActivity already
      calls setTheme(AppTheme_NoActionBar) in onCreate.
    -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/splash</item>
        <item name="windowSplashScreenBackground">@color/splash_background</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
    </style>
</resources>