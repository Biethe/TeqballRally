{
  "name": "teqball",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:lan": "vite --host",
    "build": "vite build",
    "preview": "vite preview",
    "android:sync": "npm run build && cap sync android",
    "android:apk": "npm run android:sync && cd android && ./gradlew assembleDebug",
    "android:open": "cap open android",
    "relay": "node server/relay.mjs",
    "rules": "node scripts/build-rules.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm run test",
    "verify:practice": "node scripts/verify-practice.mjs"
  },
  "dependencies": {
    "@babylonjs/core": "^7.35.0",
    "@babylonjs/loaders": "^7.35.0",
    "@capacitor/android": "^7.6.8",
    "@capacitor/core": "^7.6.8",
    "@revenuecat/purchases-capacitor": "^11.3.2",
    "@revenuecat/purchases-capacitor-ui": "^11.3.2"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.6.8",
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.1",
    "eslint": "^9.39.5",
    "globals": "^15.15.0",
    "playwright-core": "^1.60.0",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.66.0",
    "vite": "^5.4.8",
    "vitest": "^3.2.7",
    "ws": "^8.21.2"
  }
}
